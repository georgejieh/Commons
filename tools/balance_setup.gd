class_name BalanceSetup
extends RefCounted
## What a balance harness run was asked for and took, as its report's opening names it.

## Seeds every strategy finished.
var seeds: int = 0
var first_seed: int = 0
var stake: int = 0
## The time budget in minutes, or 0 for none.
var minutes: float = 0.0
var jobs: int = 1
var wall_seconds: float = 0.0
## The deals an Expert villager sampled, or 0 for the game's own number.
var expert_samples: int = 0
