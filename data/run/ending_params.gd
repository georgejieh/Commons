class_name EndingParams
extends Resource
## The numbers that pick a run's ending and its villagers' epilogue lines (ADR 0024). The
## meters' high and mid bands are MeterBands', not these.

## The Commons replaces The Secret Contract only at or below this final Resentment.
@export var collective_resentment: int = 10
## A family whose pull on the player is at or above this is bitter in its epilogue.
@export var bitter_pull: float = 0.5
## Decorative Chinese an ending's title card carries, by ending ID. Never needed to read.
@export var seals: Dictionary[String, String] = {}
